              "  pm.response.json();",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "06 查询逐条结果（CSV 当前页）",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "text/csv"
          }
        ],
        "url": "{{dashboard_api_base}}/tasks/{{task_id}}/items?page=0&size=25",
        "description": "仍为分页，需手工递增 page。"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.environment.get('access_token')) {",
              "  throw new Error('先成功获取 access_token；匿名检查不等于鉴权联调。');",
              "}"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.environment.get('task_id')) throw new Error('先取得真实 task_id。');"
            ]
          }
        }
      ]
    },
    {
      "name": "07 列出注册任务",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{dashboard_api_base}}/tasks?taskType=DPP_REGISTRATION&extended=true&page=0&size=25",
        "description": ""
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.environment.get('access_token')) {",
              "  throw new Error('先成功获取 access_token；匿名检查不等于鉴权联调。');",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('返回 JSON，而非门户 HTML', function () {",
              "  pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json');",
              "  pm.response.json();",
              "});"
            ]
          }
        }
      ]
    }
  ]
