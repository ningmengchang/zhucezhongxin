{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision", "reason", "coveredTopics", "gaps", "criticalGaps", "nextQueries", "webQueries", "webRequired", "questionProfile"],
  "properties": {
    "decision": {"type": "string", "enum": ["sufficient", "search_local", "search_web", "unresolved"]},
    "reason": {"type": "string"},
    "coveredTopics": {"type": "array", "items": {"type": "string"}},
    "gaps": {"type": "array", "items": {"type": "string"}},
    "criticalGaps": {"type": "array", "items": {"type": "string"}},
    "nextQueries": {"type": "array", "items": {"type": "string"}, "maxItems": 6},
    "webQueries": {"type": "array", "items": {"type": "string"}, "maxItems": 6},
    "webRequired": {"type": "boolean"},
    "questionProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interpretedQuestion", "complexity", "intents", "requiredBlockTypes", "focusAreas", "targetCharacters"],
      "properties": {
        "interpretedQuestion": {"type": "string"},
        "complexity": {"type": "string", "enum": ["simple", "standard", "complex"]},
        "intents": {"type": "array", "items": {"type": "string"}},
        "requiredBlockTypes": {
          "type": "array",
          "items": {"type": "string", "enum": ["deep_analysis", "comparison_table", "field_matrix", "responsibility_matrix", "process", "checklist", "decision_rules", "example", "common_mistakes"]}
        },
        "focusAreas": {"type": "array", "items": {"type": "string"}},
        "targetCharacters": {"type": "integer", "minimum": 700, "maximum": 5000}
      }
    }
  }
}
