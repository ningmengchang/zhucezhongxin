{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "title", "conclusion", "explanations", "providerAdvice"],
  "properties": {
    "status": {"type": "string", "enum": ["answered", "partial", "unresolved", "system_error"]},
    "title": {"type": "string", "maxLength": 80},
    "conclusion": {"$ref": "#/$defs/statement"},
    "explanations": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/statement"}},
    "providerAdvice": {"type": "array", "maxItems": 2, "items": {"$ref": "#/$defs/advice"}}
  },
  "$defs": {
    "basis": {"type": "string", "enum": ["regulatory_requirement", "official_interpretation", "standard_guidance", "engineering_recommendation", "uncertainty"]},
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statementId", "text", "basis", "sourceRefs"],
      "properties": {
        "statementId": {"type": "string"},
        "text": {"type": "string", "maxLength": 300},
        "basis": {"$ref": "#/$defs/basis"},
        "sourceRefs": {"type": "array", "maxItems": 6, "items": {"type": "string"}}
      }
    },
    "advice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statementId", "text", "basis", "sourceRefs"],
      "properties": {
        "statementId": {"type": "string"},
        "text": {"type": "string", "maxLength": 200},
        "basis": {"$ref": "#/$defs/basis"},
        "sourceRefs": {"type": "array", "maxItems": 6, "items": {"type": "string"}}
      }
    }
  }
}
