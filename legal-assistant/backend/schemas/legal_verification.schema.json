{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["overall", "coverageStatus", "results", "revisedSummary", "supplementalClaims", "coverageGaps"],
  "properties": {
    "overall": {"type": "string", "enum": ["pass", "partial", "fail"]},
    "coverageStatus": {"type": "string", "enum": ["complete", "incomplete"]},
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claimId", "verdict", "reason"],
        "properties": {
          "claimId": {"type": "string"},
          "verdict": {"type": "string", "enum": ["supported", "partially_supported", "unsupported", "conflict"]},
          "reason": {"type": "string"}
        }
      }
    },
    "revisedSummary": {"type": "string"},
    "supplementalClaims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claimId", "text", "analysis", "nature", "supportStatus", "citations"],
        "properties": {
          "claimId": {"type": "string"},
          "text": {"type": "string"},
          "analysis": {"type": "string"},
          "nature": {"type": "string", "enum": ["legal_fact", "implementation_advice", "uncertain"]},
          "supportStatus": {"type": "string", "enum": ["supported", "partially_supported", "unsupported"]},
          "citations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["evidenceId", "documentId", "sourceLevel", "article", "page", "quote", "interpretation"],
              "properties": {
                "evidenceId": {"type": "string"},
                "documentId": {"type": "string"},
                "sourceLevel": {"type": "string", "enum": ["A1", "A2", "B", "C", "D"]},
                "article": {"type": ["string", "null"]},
                "page": {"type": "integer", "minimum": 1},
                "quote": {"type": "string"},
                "interpretation": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "coverageGaps": {"type": "array", "items": {"type": "string"}}
  }
}
