{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "markdown", "webSources"],
  "properties": {
    "status": {"type": "string", "enum": ["answered", "partial", "unresolved", "system_error"]},
    "markdown": {"type": "string"},
    "webSources": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url", "publisher", "quote", "publicationDate", "effectiveDate"],
        "properties": {
          "title": {"type": "string", "minLength": 1, "maxLength": 500},
          "url": {"type": "string", "minLength": 12, "maxLength": 2000},
          "publisher": {"type": "string", "maxLength": 300},
          "quote": {"type": "string", "minLength": 20, "maxLength": 5000},
          "publicationDate": {"type": ["string", "null"], "format": "date"},
          "effectiveDate": {"type": ["string", "null"], "format": "date"}
        }
      }
    }
  }
}
