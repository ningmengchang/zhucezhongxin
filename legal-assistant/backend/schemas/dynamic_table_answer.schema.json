{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "title", "conclusion", "table"],
  "properties": {
    "status": {"type": "string", "enum": ["answered", "partial", "unresolved", "system_error"]},
    "title": {"type": "string", "maxLength": 80},
    "conclusion": {"$ref": "#/$defs/statement"},
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["columns", "rows"],
      "properties": {
        "columns": {"type": "array", "minItems": 2, "maxItems": 5, "items": {"type": "string", "maxLength": 24}},
        "rows": {"type": "array", "maxItems": 12, "items": {"$ref": "#/$defs/row"}}
      }
    }
  },
  "$defs": {
    "basis": {"type": "string", "enum": ["regulatory_requirement", "official_interpretation", "standard_guidance", "engineering_recommendation", "uncertainty"]},
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statementId", "text", "basis", "sourceRefs"],
      "properties": {
        "statementId": {"type": "string"},
        "text": {"type": "string", "maxLength": 300},
        "basis": {"$ref": "#/$defs/basis"},
        "sourceRefs": {"type": "array", "maxItems": 6, "items": {"type": "string"}}
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rowId", "cells", "basis", "sourceRefs"],
      "properties": {
        "rowId": {"type": "string"},
        "cells": {"type": "array", "minItems": 2, "maxItems": 5, "items": {"type": "string", "maxLength": 500}},
        "basis": {"$ref": "#/$defs/basis"},
        "sourceRefs": {"type": "array", "maxItems": 6, "items": {"type": "string"}}
      }
    }
  }
}
