{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["overall", "coverageStatus", "unsupportedParagraphIds", "partialParagraphIds", "unsupportedServiceItemIds", "coverageGaps", "reviewNote"],
  "properties": {
    "overall": {"type": "string", "enum": ["pass", "partial", "fail"]},
    "coverageStatus": {"type": "string", "enum": ["complete", "incomplete"]},
    "unsupportedParagraphIds": {"type": "array", "items": {"type": "string"}},
    "partialParagraphIds": {"type": "array", "items": {"type": "string"}},
    "unsupportedServiceItemIds": {"type": "array", "items": {"type": "string"}},
    "coverageGaps": {"type": "array", "items": {"type": "string"}},
    "reviewNote": {"type": "string"}
  }
}
