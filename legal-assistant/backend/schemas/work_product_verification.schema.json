{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["overall", "unsupportedItemIds", "partialItemIds", "reclassifications", "revisions", "missingDeliverables", "reviewNote"],
  "properties": {
    "overall": {"type": "string", "enum": ["pass", "partial", "fail"]},
    "unsupportedItemIds": {"type": "array", "items": {"type": "string"}},
    "partialItemIds": {"type": "array", "items": {"type": "string"}},
    "reclassifications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["itemId", "newBasis", "reason"],
        "properties": {
          "itemId": {"type": "string"},
          "newBasis": {"type": "string", "enum": ["official_interpretation", "standard_guidance", "engineering_recommendation", "uncertainty"]},
          "reason": {"type": "string"}
        }
      }
    },
    "revisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["itemId", "revisedText", "reason"],
        "properties": {
          "itemId": {"type": "string"},
          "revisedText": {"type": "string"},
          "reason": {"type": "string"}
        }
      }
    },
    "missingDeliverables": {"type": "array", "items": {"type": "string"}},
    "reviewNote": {"type": "string"}
  }
}
