{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "summary", "claims", "implementationAdvice", "missingEvidence", "searchedSources"],
  "properties": {
    "status": {"type": "string", "enum": ["answered", "partial", "insufficient_evidence", "system_error"]},
    "summary": {"type": "string"},
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claimId", "text", "analysis", "nature", "supportStatus", "citations"],
        "properties": {
          "claimId": {"type": "string"},
          "text": {"type": "string"},
          "analysis": {"type": "string"},
          "nature": {"type": "string", "enum": ["legal_fact", "implementation_advice", "uncertain"]},
          "supportStatus": {"type": "string", "enum": ["supported", "partially_supported", "unsupported"]},
          "citations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["evidenceId", "documentId", "article", "page", "quote", "interpretation"],
              "properties": {
                "evidenceId": {"type": "string"},
                "documentId": {"type": "string"},
                "article": {"type": ["string", "null"]},
                "page": {"type": "integer", "minimum": 1},
                "quote": {"type": "string"},
                "interpretation": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "implementationAdvice": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["advice", "basis", "nature"],
        "properties": {
          "advice": {"type": "string"},
          "basis": {"type": "string"},
          "nature": {"type": "string", "const": "implementation_advice"}
        }
      }
    },
    "missingEvidence": {"type": "array", "items": {"type": "string"}},
    "searchedSources": {"type": "array", "items": {"type": "string"}}
  }
}
